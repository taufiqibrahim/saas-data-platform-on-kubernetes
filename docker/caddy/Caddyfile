# control-plane-api development server ran using pnpm dev
apidev.saas.internal {
	reverse_proxy host.docker.internal:5001 {
		# Pass client certificate subject as header to Express
		header_up ssl-client-subject-dn {http.request.tls.client.subject}
	}
	tls {
		issuer acme {
			dir https://ca.saas.internal:9000/acme/acme/directory
			trusted_roots /step-ca-certs/root_ca.crt
		}
		client_auth {
			# Caddy verifies client cert if presented; no cert = allowed through
			mode verify_if_given
			trust_pool file {
				pem_file /step-ca-certs/root_ca.crt /step-ca-certs/intermediate_ca.crt
			}
		}
	}
}

# control-plane-ui development server ran using npm run dev
uidev.saas.internal {
	respond "HTTPS OK uidev.saas.internal"
	tls {
		issuer acme {
			# The internal URL of your step-ca container
			dir https://ca.saas.internal:9000/acme/acme/directory

			# Caddy MUST trust the step-ca root certificate to talk to it
			trusted_roots /step-ca-certs/root_ca.crt
		}
	}
}
