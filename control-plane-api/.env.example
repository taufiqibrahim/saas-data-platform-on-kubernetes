# Base
BASE_URL=http://localhost:3000

LISTEN_PORT=3000
LOG_LEVEL=debug
PINO_MULTILINE=true
HTTP_LOGGING_ENABLED=true
JSON_LIMIT=10mb

# Allowed tokens for external app
BFF_TOKEN=bff-elgxxxxxxxxxxxxxxxx

NODE_ENV=development
BASE_PROTOCOL=https
BASE_DOMAIN=dev.sparq-qd.com
DATABASE_URL=postgresql://sparqd:sparqd@localhost:5432/sparqd?schema=public&connection_limit=5&socket_timeout=3
CONTROL_PLANE_REDIRECT_URI=http://localhost:3000/*

SPARQ_ROLES_CONFIG_PATH=src/resources/authentication/sparq_roles.json
SPARQ_CLIENTS_CONFIG_PATH=src/resources/authentication/sparq_clients.json

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:3000,*,0.0.0.0
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Account-UID,x-account-uid
CORS_EXPOSED_HEADERS=Content-Type,Authorization,X-Account-UID,x-account-uid
CORS_MAX_AGE=600
CORS_OPTIONS_SUCCESS_STATUS=204

# # Keycloak
KEYCLOAK_ISSUER=http://keycloak.local:8080/realms/global-users
KEYCLOAK_PROVISIONING_ENABLE_LOCAL_CLIENTS=true

# Keycloak Admin
KEYCLOAK_ADMIN_HOST=localhost
KEYCLOAK_ADMIN_PROTOCOL=http
KEYCLOAK_ADMIN_PORT=8080
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin

# Postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=3
REDIS_CONNECT_TIMEOUT=5

# Default AWS Provider
PROVISIONING_FREE_TIER_AWS_DEFAULT_REGION=ap-southeast-1
PROVISIONING_FREE_TIER_AWS_S3_BUCKET=sparqd-staging-temp
PROVISIONING_FREE_TIER_AWS_VPC_ID=vpc-0a0f72460aa086da2
PROVISIONING_FREE_TIER_AWS_SUBNET_IDS=subnet-082ad65baa56cb516,subnet-04ebfd25940334538
PROVISIONING_FREE_TIER_AWS_SECURITY_GROUP_IDS=sg-07c99df12673d47ff,sg-071777efee6aef1a5
PROVISIONING_FREE_TIER_AWS_EKS_CLUSTER_NAME=sparqd-free-tier-staging

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# Tofu
TOFU_TEMPLATE_DIR=/app/tofu-template
TOFU_REPO_URL=git@github.com:sparqd/sparqd-infra-master.git
TOFU_REPO_REVISION=core-platform/0.0.1

# AWS
TOFU_AWS_REGION=ap-southeast-1
TOFU_AWS_S3_BUCKET=core-platform-client-tfstate-558824711273
TOFU_AWS_CROSS_ACCOUNT_ROLE_ARN =arn:aws:iam::558824711273:role/cross-account-automation-role

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587,
SMTP_SECURE=true
SMTP_USER=user
SMTP_PASSWORD=password
SMTP_MAIL_FROM=noreply@example.com
SMTP_STARTTLS=true
SMTP_SSL=true

# Workflow
ACCOUNT_WORKFLOW_ENABLED=true
WORKSPACE_WORKFLOW_ENABLED=true
