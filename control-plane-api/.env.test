# Integration test environment
BASE_URL=http://localhost:5001
LISTEN_PORT=5001
LOG_LEVEL=warn
PINO_MULTILINE=false
HTTP_LOGGING_ENABLED=false
JSON_LIMIT=10mb

BFF_TOKEN=bff-test-token

NODE_ENV=test
BASE_PROTOCOL=http
BASE_DOMAIN=saas.localhost
DATABASE_URL=postgresql://saas:saas@localhost:15432/saas_test?schema=public&connection_limit=5&socket_timeout=3

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,OPTIONS,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=Content-Type,Authorization

# Keycloak (test instance)
KEYCLOAK_HOST=http://localhost:18080
KEYCLOAK_REALM=controlplane
KEYCLOAK_ISSUER=
KEYCLOAK_PROVISIONING_ENABLE_LOCAL_CLIENTS=true

KEYCLOAK_ADMIN_HOST=localhost
KEYCLOAK_ADMIN_PROTOCOL=http
KEYCLOAK_ADMIN_PORT=18080
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin

# Cerbos (test instance)
CERBOS_ENDPOINT=localhost:13592

# Temporal (not needed for admin tests, but config expects it)
TEMPORAL_ADDRESS=localhost:17233

# CA
CA_PROVIDER=self-signed
