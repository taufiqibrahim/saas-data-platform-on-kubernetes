// ********************************************************************************************************************
//    Workspace
// ********************************************************************************************************************
enum WorkspaceStatus {
  PENDING
  CREATING
  CREATE_FAILED
  RUNNING
  UPDATING
  UPDATE_FAILED
  STOPPING
  STOPPED
  STOP_FAILED
  DELETING
  DELETE_FAILED
  DELETED
}

model Workspace {
  id             BigInt          @id @default(autoincrement())
  uid            String          @unique @default(uuid())
  extWorkspaceId String
  name           String
  description    String?
  metadata       Json?           @default("{}")
  status         WorkspaceStatus @default(PENDING)

  account   Account @relation("AccountToWorkspace", fields: [accountId], references: [id], onDelete: Restrict)
  accountId BigInt

  clusterAgent   WorkspaceClusterAgent?  @relation("CurrentWorkspaceClusterAgent", fields: [clusterAgentId], references: [id], onDelete: Cascade)
  clusterAgentId BigInt?                 @unique // MUST be unique for 1-1
  clusterAgents  WorkspaceClusterAgent[] @relation("WorkspaceToClusterAgents")

  // bootstrapTokens WorkspaceBootstrapToken[] @relation("WorkspaceToBootstrapTokens")

  // cloudRegion   CloudRegion @relation("WorkspaceToCloudRegion", fields: [cloudRegionId], references: [id])
  // cloudRegionId Int

  // // Workspace Configuration
  // credential   AccountCredential @relation("AccountCredentialToWorkspace", fields: [credentialId], references: [id], onDelete: Restrict)
  // credentialId BigInt

  // storage   AccountStorage @relation("AccountStorageToWorkspace", fields: [storageId], references: [id], onDelete: Restrict)
  // storageId BigInt

  // network   AccountNetwork? @relation("AccountNetworkToWorkspace", fields: [networkId], references: [id], onDelete: Restrict)
  // networkId BigInt?

  // // Relation to WorkspaceProvisioningConfig
  // currentConfig   WorkspaceProvisioningConfig?  @relation("CurrentWorkspaceProvisioningConfig", fields: [currentConfigId], references: [id])
  // currentConfigId BigInt?                       @unique // MUST be unique for 1-1
  // configs         WorkspaceProvisioningConfig[] @relation("WorkspaceToProvisioningConfigs")

  // members WorkspaceMember[] @relation("WorkspaceToWorkspaceMember")

  // apps WorkspaceApp[] @relation("WorkspaceToWorkspaceApp")

  createdBy   Principal @relation("WorkspaceCreatedBy", fields: [createdById], references: [id])
  createdById BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([extWorkspaceId, deletedAt])
  @@unique([accountId, name, deletedAt])
  @@index([accountId, extWorkspaceId, name])
  @@map("workspaces")
}

enum WorkspaceClusterAgentStatus {
  PendingRegistration
  Active
  Suspended
  Deleted
}

model WorkspaceClusterAgent {
  id  BigInt @id @default(autoincrement())
  uid String @unique @default(uuid())

  workspace           Workspace  @relation("WorkspaceToClusterAgents", fields: [workspaceId], references: [id])
  workspaceId         BigInt
  currentForWorkspace Workspace? @relation("CurrentWorkspaceClusterAgent")

  bootstrapToken   WorkspaceClusterAgentBootstrapToken?  @relation("CurrentWorkspaceClusterAgentBootstrapToken", fields: [bootstrapTokenId], references: [id])
  bootstrapTokenId BigInt?                               @unique
  bootstrapTokens  WorkspaceClusterAgentBootstrapToken[] @relation("WorkspaceClusterAgentToBootstrapTokens")

  mtlsCredential   WorkspaceClusterAgentMTLSCredential?  @relation("CurrentWorkspaceClusterAgentMTLSCredential", fields: [mtlsCredentialId], references: [id])
  mtlsCredentialId BigInt?                               @unique
  mtlsCredentials  WorkspaceClusterAgentMTLSCredential[] @relation("WorkspaceClusterAgentToMTLSCredentials")

  status WorkspaceClusterAgentStatus @default(PendingRegistration)

  lastPingAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("workspace_cluster_agents")
}

model WorkspaceClusterAgentBootstrapToken {
  id  BigInt @id @default(autoincrement())
  uid String @unique @default(uuid())

  workspaceClusterAgent           WorkspaceClusterAgent  @relation("WorkspaceClusterAgentToBootstrapTokens", fields: [workspaceClusterAgentId], references: [id])
  workspaceClusterAgentId         BigInt
  currentForWorkspaceClusterAgent WorkspaceClusterAgent? @relation("CurrentWorkspaceClusterAgentBootstrapToken")

  token     String
  createdAt DateTime @default(now())
  expiredAt DateTime

  @@map("workspace_cluster_agent_bootstrap_tokens")
}

model WorkspaceClusterAgentMTLSCredential {
  id  BigInt @id @default(autoincrement())
  uid String @unique @default(uuid())

  workspaceClusterAgent           WorkspaceClusterAgent  @relation("WorkspaceClusterAgentToMTLSCredentials", fields: [workspaceClusterAgentId], references: [id])
  workspaceClusterAgentId         BigInt
  currentForWorkspaceClusterAgent WorkspaceClusterAgent? @relation("CurrentWorkspaceClusterAgentMTLSCredential")

  // CA provider type used to issue this certificate
  caProvider String @default("self-signed") // "self-signed" | "step-ca" | "aws-pca"

  // CA certificate - required for self-signed (unique per workspace), optional for step-ca/aws-pca (shared CA)
  caCert String? @db.Text

  // Certificate serial number for tracking/revocation (hex string)
  certSerialNumber String?

  // Certificate fingerprint (SHA-256 hash of DER-encoded cert)
  certFingerprint String?

  createdAt DateTime @default(now())
  expiresAt DateTime // Certificate expiration date

  @@map("workspace_cluster_agent_mtls_credentials")
}

