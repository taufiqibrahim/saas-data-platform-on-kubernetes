datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ****************************************************************************
//    COMMON ENUMS
// ****************************************************************************
enum PlatformProviderNameEnum {
  KUBERNETES
  AWS_EKS
  ALICLOUD_ACK
}

enum RoleTypeEnum {
  MANAGED_ROLE
  CUSTOMER_MANAGED_ROLES
}

model PlatformProvider {
  id          Int                      @id @default(autoincrement())
  uid         String                   @unique @default(uuid()) // Public-facing
  name        PlatformProviderNameEnum @unique
  displayName String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?
  accounts    Account[]
  regions     PlatformProviderRegion[]

  @@map("platform_providers")
}

model PlatformProviderRegion {
  id          Int    @id @default(autoincrement())
  uid         String @unique @default(uuid()) // Public-facing
  name        String
  displayName String

  platformProvider   PlatformProvider @relation(fields: [platformProviderId], references: [id])
  platformProviderId Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]

  @@unique([platformProviderId, name])
  @@map("platform_provider_regions")
}

// ****************************************************************************
//    Principal as Core Identity
//    Covers: users, agents, service accounts
// ****************************************************************************
model Principal {
  id         BigInt    @id @default(autoincrement())
  uid        String    @unique @default(uuid()) // Public-facing
  externalId String // user:123 | agent:cluster-1
  kind       String // user | service | agent
  email      String    @unique
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  principalSystemRoles PrincipalSystemRole[]

  policyDefinitionsCreated PolicyDefinition[] @relation("PolicyDefinitionCreatedBy")
  policyDefinitionsUpdated PolicyDefinition[] @relation("PolicyDefinitionUpdatedBy")

  // Accounts
  accountsCreated     Account[]       @relation("AccountCreatedBy")
  accountRolesCreated AccountRole[]   @relation("AccountRoleCreatedBy")
  accountMembers      AccountMember[] @relation("PrincipalToAccountMember")

  // accountCredentialsCreated AccountCredential[] @relation("AccountCredentialCreatedBy")
  // accountNetworksCreated    AccountNetwork[]    @relation("AccountNetworkCreatedBy")
  // accountStoragesCreated    AccountStorage[]    @relation("AccountStorageCreatedBy")

  // workspaceMembers  WorkspaceMember[] @relation("UserToWorkspaceMember")
  workspacesCreated Workspace[] @relation("WorkspaceCreatedBy")

  // workspaceApps       WorkspaceApp[]       @relation("WorkspaceAppCreatedBy")
  // workspaceAppConfigs WorkspaceAppConfig[] @relation("WorkspaceAppConfigCreatedBy")

  // invites AccountInvite[] @relation("UserInvitedBy")

  // resourcePermissions ResourcePermission[] @relation("UserToResourcePermission")
  // resourcesCreated    Resource[]           @relation("ResourceCreatedBy")
  // accountRoles       AccountRole[]
  // accountMemberships AccountMembership[]

  @@map("principals")
}

// Cerbos implementation
enum PolicyScopeEnum {
  SYSTEM
  ACCOUNT
  WORKSPACE
}

model PolicyDefinition {
  id   BigInt @id @default(autoincrement())
  uid  String @unique @default(uuid()) // Public-facing
  name String @unique

  scope PolicyScopeEnum

  accountId   BigInt?
  workspaceId BigInt?

  priority Int     @default(100)
  enabled  Boolean @default(true)

  definition String @db.Text

  createdAt   DateTime  @default(now())
  createdBy   Principal @relation("PolicyDefinitionCreatedBy", fields: [createdById], references: [id])
  createdById BigInt

  updatedAt   DateTime  @updatedAt
  updatedBy   Principal @relation("PolicyDefinitionUpdatedBy", fields: [updatedById], references: [id])
  updatedById BigInt

  @@map("policy_definitions")
}

model SystemRole {
  id                   BigInt                @id @default(autoincrement())
  uid                  String                @unique @default(uuid()) // Public-facing
  name                 String                @unique
  createdAt            DateTime              @default(now())
  principalSystemRoles PrincipalSystemRole[]

  @@map("system_roles")
}

model PrincipalSystemRole {
  id          BigInt    @id @default(autoincrement())
  principalId BigInt
  principal   Principal @relation(fields: [principalId], references: [id])

  roleId BigInt
  role   SystemRole @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([principalId, roleId])
  @@map("principal_system_roles")
}

// ****************************************************************************
//    Account
// ****************************************************************************
enum AccountPlanEnum {
  free
  enterprise
}

enum AccountStatusEnum {
  PROVISIONING // Account is being created (DB + Keycloak + other setup)
  PROVISION_FAILED // Setup failed, can retry or alert
  ACTIVE // Fully ready and usable
  UPDATING // Account config or resources are being updated
  UPDATE_FAILED // Update failed
  DELETING // Account deletion in progress
  DELETE_FAILED // Deletion failed
  DELETED // Account successfully deleted
}

model Account {
  id           BigInt @id @default(autoincrement())
  uid          String @unique @default(uuid())
  extAccountId String
  name         String

  platformProvider   PlatformProvider @relation(fields: [platformProviderId], references: [id])
  platformProviderId Int

  platformProviderRegion   PlatformProviderRegion @relation(fields: [platformProviderRegionId], references: [id])
  platformProviderRegionId Int

  plan   AccountPlanEnum   @default(enterprise)
  status AccountStatusEnum @default(PROVISIONING)

  metadata    Json?     @default("{}")
  createdAt   DateTime  @default(now())
  createdBy   Principal @relation("AccountCreatedBy", fields: [createdById], references: [id])
  createdById BigInt
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  roles      AccountRole[]   @relation("AccountToAccountRole")
  members    AccountMember[] @relation("AccountToAccountMember")
  // invites    AccountInvite[] @relation("AccountToAccountInvite")
  workspaces Workspace[]     @relation("AccountToWorkspace")

  // resourcePermissions ResourcePermission[] @relation("AccountToResourcePermission")
  // resource            Resource[]           @relation("AccountToResource")
  // accountBilling      AccountBilling[]     @relation("AccountToAccountBilling")
  // credential          AccountCredential[]  @relation("AccountToAccountCredential")
  // storage             AccountStorage[]     @relation("AccountToAccountStorage")
  // network             AccountNetwork[]     @relation("AccountToAccountNetwork")

  @@unique([extAccountId, deletedAt])
  @@unique([name, deletedAt])
  @@map("accounts")
}

// ****************************************************************************
//    Account Membership
// ****************************************************************************
enum AccountMemberStatus {
  INVITED
  ACTIVE
}

model AccountRole {
  id          BigInt       @id @default(autoincrement())
  uid         String       @unique @default(uuid())
  name        String
  description String?
  type        RoleTypeEnum

  account     Account   @relation("AccountToAccountRole", fields: [accountId], references: [id], onDelete: Restrict)
  accountId   BigInt
  createdBy   Principal @relation("AccountRoleCreatedBy", fields: [createdById], references: [id])
  createdById BigInt
  createdAt   DateTime  @default(now())

  accountMemberRoles AccountMemberRole[] @relation("AccountRoleToAccountMemberRole")

  @@unique([accountId, name])
  @@map("account_roles")
}

model AccountMember {
  id          BigInt    @id @default(autoincrement())
  uid         String    @unique @default(uuid())
  account     Account   @relation("AccountToAccountMember", fields: [accountId], references: [id], onDelete: Restrict)
  accountId   BigInt
  principal   Principal @relation("PrincipalToAccountMember", fields: [principalId], references: [id], onDelete: Restrict)
  principalId BigInt
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  // Relations
  accountMemberRoles AccountMemberRole[] @relation("AccountMemberToAccountMemberRole")

  @@unique([accountId, principalId])
  @@map("account_members")
}

model AccountMemberRole {
  id  BigInt @id @default(autoincrement())
  uid String @unique @default(uuid())

  accountMember   AccountMember @relation("AccountMemberToAccountMemberRole", fields: [accountMemberId], references: [id])
  accountMemberId BigInt

  accountRole   AccountRole @relation("AccountRoleToAccountMemberRole", fields: [accountRoleId], references: [id])
  accountRoleId BigInt

  createdAt DateTime @default(now())

  @@unique([accountMemberId, accountRoleId])
  @@map("account_member_roles")
}

